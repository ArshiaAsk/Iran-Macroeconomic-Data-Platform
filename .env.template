# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=iran_macro_db
DATABASE_USER=iran_macro
DATABASE_PASSWORD=iran_macro_pass
DATABASE_URL=postgresql://iran_macro:iran_macro_pass@localhost:5432/iran_macro_db

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Application Settings
APP_ENV=development
DEBUG=true

# Data Collection Settings
COLLECTION_RETRY_MAX=3
COLLECTION_TIMEOUT=30
USER_AGENT_ROTATION=true

# World Bank API (no key required)
WORLD_BANK_API_URL=https://api.worldbank.org/v2

# IMF DataMapper API (no key required)
IMF_API_URL=https://www.imf.org/external/datamapper/api/v1

# EIA API (requires registration)
# Get your key from: https://www.eia.gov/opendata/register.php
EIA_API_KEY=your_eia_api_key_here
EIA_API_URL=https://api.eia.gov/v2

# Airflow (Phase 3)
AIRFLOW_HOME=./airflow
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql://iran_macro:iran_macro_pass@localhost:5432/iran_macro_db

# Dashboard Settings (Phase 7)
DASHBOARD_PORT=8501
DASHBOARD_THEME=light
