# ==============================================================================
# Iran Macroeconomic Data Platform - Environment Configuration
# ==============================================================================
#
# SETUP INSTRUCTIONS:
# 1. Copy this file to .env: `cp .env.example .env`
# 2. Replace all placeholder values with your actual configuration
# 3. Never commit .env to version control (it's in .gitignore)
#
# ==============================================================================

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# PostgreSQL connection settings for TimescaleDB
# For local development with Docker Compose, use these defaults:
#   - DATABASE_HOST=localhost
#   - DATABASE_PORT=5432 (or 5433 if 5432 is occupied)
#   - DATABASE_NAME=iran_macro_db
#   - DATABASE_USER=iran_macro
#   - DATABASE_PASSWORD=iran_macro_pass

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=iran_macro_db
DATABASE_USER=iran_macro
DATABASE_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql://iran_macro:your_secure_password_here@localhost:5432/iran_macro_db

# ------------------------------------------------------------------------------
# Logging Configuration
# ------------------------------------------------------------------------------
# LOG_LEVEL options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_FORMAT options: json, text

LOG_LEVEL=INFO
LOG_FORMAT=json

# ------------------------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------------------------
# APP_ENV options: development, staging, production
# DEBUG: true or false (disable in production!)

APP_ENV=development
DEBUG=true

# ------------------------------------------------------------------------------
# Data Collection Settings
# ------------------------------------------------------------------------------
# Retry and timeout configuration for data source connectors

COLLECTION_RETRY_MAX=3
COLLECTION_TIMEOUT=30
USER_AGENT_ROTATION=true

# Scraper settings (TGJU, SCI; CBI is gated — see docs/phase-5/VALIDATION.md)
# SCRAPER_MIN_REQUEST_INTERVAL: seconds between requests (1-2 req/sec politeness)
# SCRAPER_PAGE_TIMEOUT: page/load timeout in seconds for browser scrapes
# SCRAPER_DOWNLOAD_TIMEOUT: timeout in seconds for file downloads
# SCRAPER_MAX_DOWNLOAD_BYTES: refuse files larger than this (protects Bronze)
SCRAPER_MIN_REQUEST_INTERVAL=1.0
SCRAPER_PAGE_TIMEOUT=30
SCRAPER_DOWNLOAD_TIMEOUT=60
SCRAPER_MAX_DOWNLOAD_BYTES=10000000

# ------------------------------------------------------------------------------
# External API Configuration
# ------------------------------------------------------------------------------

# World Bank API (no authentication required)
WORLD_BANK_API_URL=https://api.worldbank.org/v2

# IMF DataMapper API (optional)
# No authentication required. Only used by `python -m src.connectors.imf`.
IMF_API_URL=https://www.imf.org/external/datamapper/api/v1

# EIA Open Data API v2 (free registration required)
# REQUIRED only for the EIA connector (`python -m src.connectors.eia`);
# the World Bank / IMF / TGJU pipelines run without it.
# Register a key: https://www.eia.gov/opendata/register.php
# Leaving the placeholder (or an empty value) makes an EIA run abort once with
# an actionable error instead of failing per indicator.
EIA_API_KEY=your_eia_api_key_here
EIA_API_URL=https://api.eia.gov/v2

# Statistical Center of Iran (SCI, amar.org.ir) — no authentication required.
# Used by `python -m src.connectors.sci_scraper`.
SCI_BASE_URL=https://www.amar.org.ir

# Optional CA bundle override for SCI. amar.org.ir serves an incomplete TLS
# chain, so the connector pins the missing intermediate shipped at
# src/connectors/certs/certum_dv_tls_g2_r39_ca.pem. Set this only to point at a
# different bundle (never disable verification).
SCI_CA_BUNDLE=

# Central Bank of Iran TSD (tsd.cbi.ir) — CBI is GATED.
# The reconnaissance gate (docs/phase-5/VALIDATION.md) found the site returns an
# F5 bot-defense challenge, so no CBI connector is implemented. Configured here
# only so a future connector reads the URL from config rather than hardcoding it.
CBI_TSD_URL=https://tsd.cbi.ir

# OPEC basket data is NOT ingested in Phase 4 — no OPEC configuration exists.
# See docs/phase-4/VALIDATION.md for the Cloudflare blockage finding.

# ------------------------------------------------------------------------------
# Phase 6 — Market & Survey Connectors (optional extras)
# ------------------------------------------------------------------------------
# These sources use a Python package as the transport, installed via Poetry
# extras (NOT part of the default install; the unit suite stays package-free):
#   poetry install --extras "tsetmc hbsir"
# Pinned versions: finpy-tse==1.2.10 (TSETMC), hbsir==0.6.6 (HBSIR). The package
# version actually used for a run is captured into Bronze provenance at runtime.

# TSETMC (Tehran Stock Exchange) — `finpy-tse`, no authentication required.
# OPEN: TSETMC.TEDPIX only. Trading value, market P/E and market cap are DEFERRED
# because the package exposes no reliable historical series for them; see
# docs/phase-6/README.md. TSETMC_BASE_URL is the raw cdn endpoint used to store
# the payload in Bronze alongside the normalized frame.
TSETMC_BASE_URL=http://cdn.tsetmc.com/api
TSETMC_TIMEOUT=30

# HBSIR (Iran Household Budget Survey) — `hbsir`, no authentication required.
# The package loads survey microdata from HBSIR_DATA_DIR, downloading cleaned
# Parquet from the Arvan S3 mirror on first use. Annual, run on demand (no DAG).
# Poverty is a documented RELATIVE measure (50% x weighted median income); it is
# NOT the official Iranian poverty line.
HBSIR_DATA_DIR=Data
HBSIR_DOWNLOAD_TIMEOUT=60

# ------------------------------------------------------------------------------
# Apache Airflow Configuration (Phase 3 - Optional)
# ------------------------------------------------------------------------------
# Airflow 3.x configuration for orchestration
# Uses the same database as the main application

AIRFLOW_HOME=./airflow
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql://iran_macro:your_secure_password_here@localhost:5432/iran_macro_db

# ------------------------------------------------------------------------------
# Dashboard Configuration (Phase 7 - Optional)
# ------------------------------------------------------------------------------
# Streamlit dashboard settings

DASHBOARD_PORT=8501
DASHBOARD_THEME=light

# ==============================================================================
# SECURITY NOTES:
# - Change DATABASE_PASSWORD from default before deploying
# - Never share .env file or commit it to version control
# - Keep EIA_API_KEY confidential
# - Use strong passwords in production environments
# ==============================================================================
