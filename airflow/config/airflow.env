# Airflow Configuration
# This file sets environment variables for Apache Airflow 3.x

# Airflow Home Directory
AIRFLOW_HOME=./airflow

# Executor: LocalExecutor for single-machine deployment
AIRFLOW__CORE__EXECUTOR=LocalExecutor

# Database: Separate Airflow metadata database on the same Postgres instance
# This keeps Airflow's internal tables separate from bronze/silver/gold/metadata
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql://iran_macro:iran_macro_pass@localhost:5432/airflow_db

# Webserver Configuration
AIRFLOW__WEBSERVER__WEB_SERVER_PORT=8080
AIRFLOW__WEBSERVER__BASE_URL=http://localhost:8080
AIRFLOW__WEBSERVER__EXPOSE_CONFIG=True
AIRFLOW__WEBSERVER__RBAC=True

# DAG Configuration
AIRFLOW__CORE__DAGS_FOLDER=./airflow/dags
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__SCHEDULER__DAG_DIR_LIST_INTERVAL=30

# Logging
AIRFLOW__LOGGING__BASE_LOG_FOLDER=./airflow/logs
AIRFLOW__LOGGING__LOGGING_LEVEL=INFO

# Security
AIRFLOW__CORE__FERNET_KEY=# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# Disable unnecessary features for local deployment
AIRFLOW__METRICS__STATSD_ON=False
AIRFLOW__SCHEDULER__SCHEDULE_AFTER_TASK_EXECUTION=False

# Timezone
AIRFLOW__CORE__DEFAULT_TIMEZONE=Asia/Tehran
AIRFLOW__CORE__DEFAULT_UI_TIMEZONE=Asia/Tehran
