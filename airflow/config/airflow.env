# Airflow Configuration
# This file sets environment variables for Apache Airflow 3.x

# Airflow Home Directory (MUST be absolute path)
AIRFLOW_HOME=/home/arshiaask/projects/Iran-Macroeconomic-Data-Platform/airflow

# Python Path - CRITICAL for LocalExecutor workers to import project modules
# Workers must be able to import src.* modules from the task callables
PYTHONPATH=/home/arshiaask/projects/Iran-Macroeconomic-Data-Platform

# Disable all proxy settings - CRITICAL for Airflow 3.x internal communication
# The system SOCKS proxy breaks httpx client initialization for localhost connections
# Workers need to connect to localhost:8793 (internal API) without any proxy
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
http_proxy=
https_proxy=
all_proxy=
NO_PROXY=localhost,127.0.0.1
no_proxy=localhost,127.0.0.1

# Executor: LocalExecutor for single-machine deployment
AIRFLOW__CORE__EXECUTOR=LocalExecutor

# Database: Separate Airflow metadata database on the same Postgres instance
# This keeps Airflow's internal tables separate from bronze/silver/gold/metadata
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql://iran_macro:iran_macro_pass@localhost:5433/airflow_db

# API Configuration (replaces webserver settings in Airflow 3.x)
AIRFLOW__API__PORT=8080
AIRFLOW__API__BASE_URL=http://localhost:8080
AIRFLOW__API__EXPOSE_CONFIG=True

# Execution API - CRITICAL for Airflow 3.x task execution
# Workers need this to communicate with the scheduler via the Execution API
AIRFLOW__EXECUTION_API__BASE_URL=http://localhost:8080

# Internal API - required for LocalExecutor in Airflow 3.x
# This is distinct from the public API; it's for scheduler-executor communication
AIRFLOW__CORE__INTERNAL_API_URL=http://localhost:8793

# DAG Configuration
AIRFLOW__CORE__DAGS_FOLDER=/home/arshiaask/projects/Iran-Macroeconomic-Data-Platform/airflow/dags
AIRFLOW__CORE__LOAD_EXAMPLES=False
# Updated config name for Airflow 3.x
AIRFLOW__DAG_PROCESSOR__REFRESH_INTERVAL=30

# Logging
AIRFLOW__LOGGING__BASE_LOG_FOLDER=/home/arshiaask/projects/Iran-Macroeconomic-Data-Platform/airflow/logs
AIRFLOW__LOGGING__LOGGING_LEVEL=INFO

# Security
AIRFLOW__CORE__FERNET_KEY=Jx9XORDdW-lPM9OOadnjqXFYKZeUOmr6fLkYJhmLWNs=

# Simple Auth Manager Configuration (Airflow 3.x)
# Define users: username:role (separated by comma)
AIRFLOW__CORE__SIMPLE_AUTH_MANAGER_USERS=admin:admin,viewer:viewer
# Password file location (auto-generated passwords stored here)
AIRFLOW__CORE__SIMPLE_AUTH_MANAGER_PASSWORDS_FILE=/home/arshiaask/projects/Iran-Macroeconomic-Data-Platform/airflow/simple_auth_manager_passwords.json

# Disable unnecessary features for local deployment
AIRFLOW__METRICS__STATSD_ON=False
AIRFLOW__SCHEDULER__SCHEDULE_AFTER_TASK_EXECUTION=False

# Timezone
AIRFLOW__CORE__DEFAULT_TIMEZONE=Asia/Tehran
AIRFLOW__CORE__DEFAULT_UI_TIMEZONE=Asia/Tehran
